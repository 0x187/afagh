# ═══ نمونهٔ متغیرهای محیطی سرویس Go آفاق ═══
# قرارداد با afagh-next یکسان است تا compose مشترک بتواند هر دو را تغذیه کند.

# زیرساخت (در production اجباری — fail-closed)
DATABASE_URL=postgres://afagh:afagh@127.0.0.1:5432/afagh_db
# نقش محدود RLS — برای مسیرهای دانشکیت (فازهای بعد)
# DATABASE_URL_APP=postgres://afagh_app:afagh_app@127.0.0.1:5432/afagh_db
REDIS_URL=
# S3_ENDPOINT=127.0.0.1:9000
# S3_BUCKET=afagh-archive
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# سرویس
PORT=8090
NODE_ENV=development
AFAGH_VERSION=go-0.1.0

# لبهٔ strangler
AFAGH_NEXT_UPSTREAM=http://127.0.0.1:8080
# SPA در dev: پروکسی به Vite | در production: مسیر dist ساخته‌شده
# AFAGH_SPA_UPSTREAM=http://127.0.0.1:5173
# AFAGH_SPA_DIST=/srv/afagh-spa
AFAGH_OWNED_PREFIXES=/api/v2,/app

# امنیت (همان ENVهای afagh-next)
# ALLOWED_EXTRA_ORIGINS=https://portal.other.ir
# AFAGH_SESSION_COOKIE_PREFIX=host

# لاگ
LOG_LEVEL=info
# LOG_FORMAT=json|pretty
